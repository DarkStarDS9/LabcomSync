{
  "labcomGraphqlUrl": "https://backend.labcom.cloud/graphql",
  "prometheusUrl": "http://prometheus:9090",
  "syncComment": "prometheus-sync",
  "intervalSeconds": 900,
  "lookbackDays": 30,
  "topN": 10,
  "mappings": [
    {
      "name": "Chlorine measurements",
      "triggerScenarioContains": "8–CL",
      "targets": [
        {
          "scenarioContains": "manually added",
          "prometheusMetric": "bayrol_redox_value",
          "parameterId": 161
        },
        {
          "scenarioContains": "manually added",
          "prometheusMetric": "bayrol_temperature_value",
          "parameterId": 124
        }
      ]
    }
  ],
  "grafanaUrl": "http://grafana:3000",
  "grafanaDashboardUid": "",
  "annotationStatePath": "/data/annotated_state.json",
  "exports": [
    {
      "name": "DPD1",
      "parameterId": 321,
      "unit": "mg/L"
    }
  ]
}
